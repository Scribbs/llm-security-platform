# ============================================
# LLM Security Assessment Platform - Environment
# ============================================

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ChangeMeImmediately!
KEYCLOAK_REALM=lsap
KEYCLOAK_CLIENT_ID=lsap-frontend
KEYCLOAK_CLIENT_SECRET=          # leave empty for public client or set for confidential

# Database
POSTGRES_USER=lsap
POSTGRES_PASSWORD=lsap_secure_pass
POSTGRES_DB=lsap

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
BACKEND_SECRET_KEY=change-this-to-a-long-random-string
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
RESULTS_DIR=/results
JOB_TIMEOUT_SECONDS=3600

# Optional default keys (can also be supplied per-scan)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Frontend
VITE_API_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=lsap
VITE_KEYCLOAK_CLIENT_ID=lsap-frontend

# Tool-specific
GARAK_PROBES=encoding,promptinject,dan,lmrc,xss
DEEPTEAM_FRAMEWORK=OWASPTop10
